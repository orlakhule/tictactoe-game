# ─────────────────────────────────────────────────────────────
# CHARIS — Deployment Environment Variables (TEMPLATE)
# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your real credentials.
#
#   cp .env.example .env
#
# This file (.env.example) is tracked by git. The .env file is
# gitignored and must NEVER be committed to the repository.
# ─────────────────────────────────────────────────────────────

# ── GitHub Personal Access Token ──────────────────────────────
# Used to authenticate when pushing to GitHub over HTTPS.
# Create one at: https://github.com/settings/tokens
# Required scopes:
#   - repo    (to push to the repository)
GITHUB_TOKEN=

# ── Netlify Auth Token ───────────────────────────────────────
# Used by the Netlify CLI to deploy this site.
# Get it from: https://app.netlify.com/user/applications
#   → "Personal access tokens" → "New access token"
NETLIFY_AUTH_TOKEN=

# ── Netlify Site ID (optional) ────────────────────────────────
# The ID of an existing Netlify site to deploy to.
# If left blank, the CLI will prompt you to select/create a site.
# Find it at: Site settings → General → Site information → "Site ID"
NETLIFY_SITE_ID=
